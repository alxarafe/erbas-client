# Preserve the original encoded ID: Nginx normalizes $uri before selecting a location.
map $request_uri $user_detail_path {
    default "";
    ~^/backends/(?:java|dotnet)(/api/users/[^/?]+)(?:\?.*)?$ $1;
}
map $request_uri $user_detail_upstream {
    default "";
    ~^/backends/java/api/users/ ${ERBAS_JAVA_UPSTREAM};
    ~^/backends/dotnet/api/users/ ${ERBAS_DOTNET_UPSTREAM};
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    resolver 127.0.0.11 valid=5s ipv6=off;

    location = /backends/java/health {
        set $upstream "${ERBAS_JAVA_UPSTREAM}";
        proxy_pass http://$upstream/health;
        include /etc/nginx/health-proxy.conf;
    }
    location = /backends/dotnet/health {
        set $upstream "${ERBAS_DOTNET_UPSTREAM}";
        proxy_pass http://$upstream/health;
        include /etc/nginx/health-proxy.conf;
    }
    location = /backends/java/api/auth/login {
        set $upstream "${ERBAS_JAVA_UPSTREAM}";
        proxy_pass http://$upstream/api/auth/login;
        include /etc/nginx/auth-proxy.conf;
    }
    location = /backends/dotnet/api/auth/login {
        set $upstream "${ERBAS_DOTNET_UPSTREAM}";
        proxy_pass http://$upstream/api/auth/login;
        include /etc/nginx/auth-proxy.conf;
    }
    location = /backends/java/api/auth/me {
        set $upstream "${ERBAS_JAVA_UPSTREAM}";
        proxy_pass http://$upstream/api/auth/me;
        limit_except GET { deny all; }
        include /etc/nginx/user-proxy.conf;
    }
    location = /backends/dotnet/api/auth/me {
        set $upstream "${ERBAS_DOTNET_UPSTREAM}";
        proxy_pass http://$upstream/api/auth/me;
        limit_except GET { deny all; }
        include /etc/nginx/user-proxy.conf;
    }
    location = /demo/defaults.env {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }
    location = /backends/java/api/users {
        set $upstream "${ERBAS_JAVA_UPSTREAM}";
        proxy_pass http://$upstream/api/users$is_args$args;
        limit_except GET POST { deny all; }
        include /etc/nginx/user-proxy.conf;
    }
    location = /backends/dotnet/api/users {
        set $upstream "${ERBAS_DOTNET_UPSTREAM}";
        proxy_pass http://$upstream/api/users$is_args$args;
        limit_except GET POST { deny all; }
        include /etc/nginx/user-proxy.conf;
    }
    location = /proxy-error { internal; return 502; }
    location /backends/ {
        if ($user_detail_path = "") { return 404; }
        proxy_pass http://$user_detail_upstream$user_detail_path;
        limit_except GET { deny all; }
        include /etc/nginx/user-proxy.conf;
    }
    location / { try_files $uri $uri/ /index.html; }
}
