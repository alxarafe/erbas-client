#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root"
for script in bin/*; do bash -n "$script"; done
docker compose config --quiet
ERBAS_CLIENT_PORT=49082 docker compose config --quiet
./bin/test
run="erbas-client-check-${BASHPID}-${RANDOM}"
cleanup() {
    local code=$?
    trap - EXIT
    for name in "$run-client" "$run-java" "$run-dotnet"; do
        if docker container inspect "$name" >/dev/null 2>&1; then
            docker container rm --force "$name" >/dev/null || code=1
        fi
    done
    if docker network inspect "$run" >/dev/null 2>&1; then
        docker network rm "$run" >/dev/null || code=1
    fi
    if docker image inspect "$run" >/dev/null 2>&1; then
        docker image rm "$run" >/dev/null || code=1
    fi
    exit "$code"
}
trap cleanup EXIT
docker build --target runtime --tag "$run" .
docker network create "$run" >/dev/null
for backend in java dotnet; do
    docker run --detach --name "$run-$backend" --network "$run" --network-alias "$backend"         -v "$root/docker/mock-backend.cjs:/mock.cjs:ro" node:24-alpine node /mock.cjs >/dev/null
done
docker run --detach --name "$run-client" --network "$run" --network-alias client     -e ERBAS_JAVA_UPSTREAM=java:8080 -e ERBAS_DOTNET_UPSTREAM=dotnet:8080 "$run" >/dev/null
docker run --rm --network "$run" -v "$root/docker/smoke.cjs:/smoke.cjs:ro" node:24-alpine node /smoke.cjs
echo 'CHECK PASS: unit tests, production build, Docker runtime and both same-origin Health and login proxies.'
