#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/demo-common"
resolve_repositories up
require_command docker
require_command curl
set_urls
set_demo_identity
ERBAS_AUTH_BOOTSTRAP_ENABLED=true \
ERBAS_AUTH_BOOTSTRAP_EMAIL="$ERBAS_DEMO_EMAIL" \
ERBAS_AUTH_BOOTSTRAP_PASSWORD="$ERBAS_DEMO_PASSWORD" \
run_owner Java "$java_dir" up
run_owner .NET "$dotnet_dir" up
run_owner Client "$demo_root" up
wait_for_http Java "$java_url"
wait_for_http .NET "$dotnet_url"
wait_for_http Client "$client_url"
printf '\nDevelopment environment ready (HTTP 200):\n  Java:   %s\n  .NET:   %s\n  Client: %s\nRun ./bin/demo-check to verify both real backend contracts and proxies.\n' "$java_url" "$dotnet_url" "$client_url"

printf 'Demo authentication identity (development only): %s\n' "$ERBAS_DEMO_EMAIL"
