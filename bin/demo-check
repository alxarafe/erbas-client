#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/demo-common"
require_command curl
require_command python3
set_urls
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
failed=0
check_health() {
    local label="$1" url="$2" metadata
    printf 'Checking %s: %s\n' "$label" "$url"
    if ! metadata="$(curl --silent --show-error --noproxy '*' --connect-timeout 2 --max-time 7 \
        --header 'Accept: application/json' --output "$scratch/body" \
        --write-out '%{http_code}\n%{content_type}' "$url")"; then
        printf 'ERROR: %s request failed.\n' "$label" >&2
        failed=1
        return
    fi
    if python3 - "$scratch/body" "$metadata" <<'PY'
import json
import sys


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON property")
        result[key] = value
    return result


try:
    status, content_type = sys.argv[2].split("\n", 1)
    if status != "200":
        raise ValueError(f"expected HTTP 200, received {status}")
    if content_type.split(";", 1)[0].strip().lower() != "application/json":
        raise ValueError(f"expected application/json, received {content_type!r}")
    with open(sys.argv[1], encoding="utf-8") as body:
        response = json.load(body, object_pairs_hook=unique_object)
    if response != {"status": "ok"}:
        raise ValueError('expected exactly {"status":"ok"}')
except (ValueError, OSError) as error:
    print(f"ERROR: {error}", file=sys.stderr)
    sys.exit(1)
PY
    then
        printf 'OK: %s\n' "$label"
    else
        printf 'ERROR: %s contract check failed: %s\n' "$label" "$url" >&2
        failed=1
    fi
}
check_health 'Java direct Health' "$java_url"
check_health '.NET direct Health' "$dotnet_url"
if http_available "$client_url"; then
    printf 'OK: Client HTTP — %s\n' "$client_url"
else
    printf 'ERROR: Client must return HTTP 200: %s\n' "$client_url" >&2
    failed=1
fi
check_health 'Client → Java Health' "$client_url/backends/java/health"
check_health 'Client → .NET Health' "$client_url/backends/dotnet/health"
(( failed == 0 )) || exit 1
printf 'DEMO CHECK PASS: real backend Health contracts, client HTTP and both proxies.\n'
